Module
  name: gamelib
  description: Contains game related classes
  author: OTClient team
  website: https://github.com/edubart/otclient

  @onLoad: |
    dofile 'const'
    dofile 'util'
    dofile 'protocol'
    dofile 'protocollogin'
    dofile 'protocolgame'
    dofile 'position'
    dofile 'game'

    dofile 'creature'
    dofile 'corrupted_creatures'
    dofile 'furious_rage_visuals'
    dofile 'bulwark_visuals'
    dofile 'critical_hit_visuals'
    dofile 'player'
    dofile 'market'
    dofile 'textmessages'
    dofile 'thing'
    dofile 'spells'
    -- dofile 'unlooted_corpses'  -- DISABLED: Using check_unlooted.lua instead

    dofiles 'ui'
