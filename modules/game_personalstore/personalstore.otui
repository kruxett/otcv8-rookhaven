MoneyWidget < UIWidget
  size: 24 17
  anchors.top: parent.top
  anchors.left: parent.left
  text: 0
  font: verdana-11px-rounded
  color: #c7d6e8

  $!first:
    anchors.left: prev.right
    margin-left: 26

MoneyPanel < UIWidget
  id: moneyPanel
  size: 144 17
  image-source: images/money

  MoneyWidget
    id: 3
  MoneyWidget
    id: 2
  MoneyWidget
    id: 1

PSItem < UIWidget
  size: 90 65
  margin-right: 2
  margin-bottom: 2

  UIWidget
    id: background
    anchors.fill: parent
    image-source: /images/ui/panel_flat
    image-border: 5
    opacity: 0.7

  Item
    id: item
    size: 42 42
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    virtual: true

    UIWidget
      id: rarityId
      anchors.fill: parent
      image-source: /images/ui/rarity_frames
      phantom: true
      visible: false

  UIWidget
    id: border
    anchors.fill: parent
    border-color: #666666
    border-width: 1
    phantom: true
    opacity: 0.5

  Button
    id: remove
    size: 16 16
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: -2
    margin-top: -2
    tooltip: Remove
    text: x
    font: verdana-10px-rounded
    visible: false

  Button
    id: buyOrEdit
    height: 18
    anchors.top: item.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin: 3
    enabled: false
    font: verdana-9px-rounded

PSPanel < UIWidget
  anchors.fill: parent
  visible: false
  phantom: true

StartStorePanel < PSPanel
  id: startStorePanel

  Label
    id: panelTitle
    text: "Store Description"
    font: verdana-12px-rounded
    color: #d0a860
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    text-auto-resize: true

  TextEdit
    id: description
    size: 280 80
    anchors.top: panelTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12

  Label
    id: taxNotice
    anchors.top: description.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    text: ""
    color: #c7d6e8
    font: verdana-10px-rounded

  Button
    id: confirm
    size: 90 24
    anchors.top: taxNotice.bottom
    anchors.left: description.left
    margin-top: 10
    text: Confirm
    font: verdana-11px-rounded

  Button
    id: cancel
    size: 90 24
    anchors.top: taxNotice.bottom
    anchors.right: description.right
    margin-top: 10
    text: Cancel
    font: verdana-11px-rounded
    @onClick: modules.game_personalstore.showMainPanel()

BuyItemPanel < PSPanel
  id: buyItemPanel

  Label
    id: panelTitle
    text: "Purchase Item"
    font: verdana-12px-rounded
    color: #d0a860
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    text-auto-resize: true

  Item
    id: item
    size: 42 42
    virtual: true
    anchors.top: panelTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12

    UIWidget
      id: rarityId
      anchors.fill: parent
      image-source: /images/ui/rarity_frames
      phantom: true
      visible: false

  HorizontalScrollBar
    id: count
    size: 240 13
    anchors.top: item.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Label
    id: countLabel
    text: "Quantity: 1"
    color: #c7d6e8
    font: verdana-10px-rounded
    anchors.top: count.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    text-auto-resize: true

  MoneyPanel
    id: price
    anchors.top: countLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Button
    id: confirm
    size: 90 24
    anchors.top: price.bottom
    anchors.left: count.left
    margin-top: 12
    text: Confirm
    font: verdana-11px-rounded

  Button
    id: cancel
    size: 90 24
    anchors.top: price.bottom
    anchors.right: count.right
    margin-top: 12
    text: Cancel
    font: verdana-11px-rounded
    @onClick: modules.game_personalstore.showMainPanel()

ItemEditPanel < PSPanel
  id: itemEditPanel

  Label
    id: panelTitle
    text: "Edit Item Price"
    font: verdana-12px-rounded
    color: #d0a860
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 15
    text-auto-resize: true

  UIItem
    id: item
    size: 42 42
    anchors.top: panelTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    UIWidget
      id: rarityId
      anchors.fill: parent
      image-source: /images/ui/rarity_frames
      phantom: true
      visible: false

  HorizontalScrollBar
    id: count
    size: 240 13
    anchors.top: item.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10

  Label
    id: countLabel
    text: "Quantity: 1"
    color: #c7d6e8
    font: verdana-10px-rounded
    anchors.top: count.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 4
    text-auto-resize: true

  UIWidget
    id: price
    size: 240 26
    anchors.top: countLabel.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 10
    tooltip: tr("Unit Price")
    image-source: /images/ui/panel_flat
    image-border: 3

    TextEdit
      id: value
      size: 90 22
      anchors.top: parent.top
      anchors.left: parent.left
      margin-left: 3
      margin-top: 2

    MoneyPanel
      anchors.left: value.right
      anchors.top: value.top
      margin-left: 8

  Label
    id: taxSummary
    anchors.top: price.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 8
    width: 260
    text-align: center
    text: "Tax: 0% | You receive: 0"
    color: #c0a050
    font: verdana-10px-rounded

  Button
    id: confirm
    size: 90 24
    anchors.top: taxSummary.bottom
    anchors.left: count.left
    margin-top: 12
    text: Confirm
    font: verdana-11px-rounded

  Button
    id: cancel
    size: 90 24
    anchors.top: taxSummary.bottom
    anchors.right: count.right
    margin-top: 12
    text: Cancel
    font: verdana-11px-rounded
    @onClick: modules.game_personalstore.showMainPanel()

MainPanel < PSPanel
  id: mainPanel
  visible: true
  margin-left: -15
  margin-top: -20

  Label
    id: storeTitle
    text: "Your Store"
    font: verdana-14px-rounded
    color: #d0a860
    anchors.top: parent.top
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12
    text-auto-resize: true

  HorizontalSeparator
    anchors.top: storeTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 15
    margin-right: 15

  ScrollablePanel
    id: itemsFlatPanel
    layout:
      type: grid
      cell-size: 42 42
      cell-spacing: 6
      flow: true
    vertical-scrollbar: itemsScrollBar
    size: 380 180
    image-border: 1
    padding: 6
    image-source: /images/ui/panel_content
    anchors.top: storeTitle.bottom
    anchors.horizontalCenter: parent.horizontalCenter
    margin-top: 12

    PSItem
      id: item1
    PSItem
      id: item2
    PSItem
      id: item3
    PSItem
      id: item4
    PSItem
      id: item5
    PSItem
      id: item6
    PSItem
      id: item7
    PSItem
      id: item8
    PSItem
      id: item9
    PSItem
      id: item10
    PSItem
      id: item11
    PSItem
      id: item12
    PSItem
      id: item13
    PSItem
      id: item14
    PSItem
      id: item15
    PSItem
      id: item16
    PSItem
      id: item17
    PSItem
      id: item18
    PSItem
      id: item19
    PSItem
      id: item20
    PSItem
      id: item21
    PSItem
      id: item22
    PSItem
      id: item23
    PSItem
      id: item24
    PSItem
      id: item25
    PSItem
      id: item26
    PSItem
      id: item27
    PSItem
      id: item28
    PSItem
      id: item29
    PSItem
      id: item30
    PSItem
      id: item31
    PSItem
      id: item32
    PSItem
      id: item33
    PSItem
      id: item34
    PSItem
      id: item35
    PSItem
      id: item36

  VerticalScrollBar
    id: itemsScrollBar
    layout:
      type: anchor
    anchors.top: itemsFlatPanel.top
    anchors.bottom: itemsFlatPanel.bottom
    anchors.right: itemsFlatPanel.right
    margin-right: -15
    step: 50
    pixels-scroll: true
    visible: false

  HorizontalSeparator
    id: separatorAboveItems
    anchors.top: itemsFlatPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 12
    margin-left: 15
    margin-right: 15

  Label
    id: purchaseLabel
    text: "Purchase Summary"
    font: verdana-12px-rounded
    color: #d0a860
    anchors.top: separatorAboveItems.bottom
    anchors.left: parent.left
    margin-top: 10
    margin-left: 20
    text-auto-resize: true

  Panel
    id: purchasePanel
    anchors.top: purchaseLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 15
    margin-right: 15
    height: 110
    padding: 8
    image-source: /images/ui/panel_flat
    image-border: 5

    Item
      id: selectedItem
      size: 56 56
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 2
      UIWidget
        id: rarityId
        anchors.fill: parent
        image-source: /images/ui/rarity_frames
        phantom: true
        visible: false

    Label
      id: itemName
      anchors.left: selectedItem.right
      anchors.top: parent.top
      margin-left: 12
      margin-top: 2
      width: 200
      text: "No Item Selected"
      color: #e0d0c0
      font: verdana-11px-rounded

    Label
      id: itemPrice
      anchors.left: selectedItem.right
      anchors.top: itemName.bottom
      margin-left: 12
      margin-top: 3
      width: 200
      text: "Price: 0"
      color: #c7d6e8
      font: verdana-10px-rounded

    Label
      id: itemAmount
      anchors.left: selectedItem.right
      anchors.top: itemPrice.bottom
      margin-left: 12
      margin-top: 2
      width: 200
      text: "Amount: 0x"
      color: #c7d6e8
      font: verdana-10px-rounded

    Label
      id: itemWeight
      anchors.left: selectedItem.right
      anchors.top: itemAmount.bottom
      margin-left: 12
      margin-top: 2
      width: 200
      text: "Weight: 0 oz"
      color: #c7d6e8
      font: verdana-10px-rounded

    HorizontalScrollBar
      id: itemCountScroll
      anchors.left: selectedItem.right
      anchors.bottom: parent.bottom
      margin-left: 12
      margin-bottom: 2
      minimum: 1
      maximum: 100
      step: 1
      value: 1
      width: 160

    Label
      id: ownerTaxNotice
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: parent.bottom
      margin-right: 8
      width: 120
      text-align: center
      text: ""
      color: #c0a050
      font: verdana-9px-rounded

    Button
      id: buyButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-right: 8
      margin-bottom: 2
      text: "Buy"
      visible: false
      width: 60
      height: 24
      font: verdana-11px-rounded
      @onClick: modules.game_personalstore.buySelectedItem()

    Button
      id: editStoreButton
      size: 85 24
      anchors.right: parent.right
      anchors.top: parent.top
      margin-right: 8
      margin-top: 2
      visible: false
      text: "Edit Store"
      font: verdana-11px-rounded
      @onClick: modules.game_personalstore.enableEditionModeOrOfflineMode()

    Button
      id: startStoreButton
      size: 85 24
      anchors.right: parent.right
      anchors.top: editStoreButton.bottom
      margin-right: 8
      margin-top: 4
      visible: false
      text: "Start Sales"
      font: verdana-11px-rounded
      @onClick: modules.game_personalstore.selectOrStartStore()

    Button
      id: editPriceButton
      size: 85 24
      anchors.right: parent.right
      anchors.top: startStoreButton.bottom
      margin-right: 8
      margin-top: 4
      visible: false
      text: "Edit Price"
      font: verdana-11px-rounded

    ScrollablePanel
      id: containerItemsPanel
      layout:
        type: grid
        cell-size: 34 34
        cell-spacing: 5
        flow: true
      vertical-scrollbar: containerItemsScrollBar
      size: 163 80
      image-border: 1
      padding: 5
      visible: false
      image-source: /images/ui/panel_flat
      anchors.top: purchasePanel.bottom
      anchors.horizontalCenter: parent.horizontalCenter
      margin-left: 25

    VerticalScrollBar
      id: containerItemsScrollBar
      layout:
        type: anchor
      anchors.top: containerItemsPanel.top
      anchors.bottom: containerItemsPanel.bottom
      anchors.right: containerItemsPanel.right
      margin-right: -15
      step: 10
      pixels-scroll: true
      visible: false

  HorizontalSeparator
    id: separatorBelowPurchase
    anchors.top: purchasePanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 10
    margin-left: 15
    margin-right: 15
    visible: false

MainWindow
  size: 520 360
  anchors.centerIn: parent
  text: Personal Store
  @onEscape: modules.game_personalstore.hide()

  Button
    id: close
    size: 20 20
    anchors.top: parent.top
    anchors.right: parent.right
    margin-right: -15
    margin-top: -5
    text: x
    font: verdana-11px-rounded
    @onClick: modules.game_personalstore.hide()

  BuyItemPanel
  ItemEditPanel
  StartStorePanel
  MainPanel
