MiniWindow
  id: passivesStatus
  text: Passives - TEST
  height: 150
  icon: /images/topbuttons/skills
  @onClose: modules.game_passives.hideStatus()
  &save: false
  &autoOpen: true

  MiniWindowContents
    padding-left: 5
    padding-right: 5

    Label
      id: capstoneLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: parent.top
      margin-top: 3
      height: 15
      font: verdana-11px-rounded
      color: #d8c08b
      text: No capstone selected

    ProgressBar
      id: rageBar
      on: true
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: capstoneLabel.bottom
      margin-top: 4
      height: 14
      font: verdana-11px-rounded
      background-color: #79382a
      text: Rage: 0 / 100

    Label
      id: berserkLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: rageBar.bottom
      margin-top: 5
      height: 14
      font: verdana-11px-rounded
      text: Berserk: inactive

    Label
      id: wardLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: berserkLabel.bottom
      margin-top: 5
      height: 14
      font: verdana-11px-rounded
      text: Shield: 0

    Label
      id: bleedLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: wardLabel.bottom
      margin-top: 5
      height: 14
      font: verdana-11px-rounded
      text: Own target bleeds: 0 / 3

    Button
      id: treeButton
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 20
      width: 85
      text: Open tree
