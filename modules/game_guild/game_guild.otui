GuildSectionLabel < Label
  height: 16
  font: verdana-11px-rounded
  color: #c8aa6e
  margin-top: 6
  margin-bottom: 2
  margin-left: 8

GuildMemberRow < Panel
  height: 28
  margin-bottom: 2
  border-width: 1
  border-color: #303030
  background-color: #1c1c1c
  focusable: true

  $hover:
    background-color: #262e38

  Panel
    id: onlineIndicator
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 7
    size: 10 10
    background-color: #555555

  Label
    id: memberName
    anchors.left: onlineIndicator.right
    anchors.right: memberRank.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 8
    margin-right: 6
    font: verdana-11px-rounded
    color: #eaeaea
    phantom: true

  Label
    id: memberRank
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 10
    font: verdana-11px-rounded
    color: #8a9ab0
    text-auto-resize: true
    phantom: true

GuildRankRow < Panel
  height: 28
  margin-bottom: 2
  border-width: 1
  border-color: #303030
  background-color: #1c1c1c

  Label
    id: rankName
    anchors.left: parent.left
    anchors.right: renameRankBtn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-rounded
    color: #ddd0a0
    phantom: true

  Button
    id: renameRankBtn
    anchors.right: deleteRankBtn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    size: 56 20
    text: Rename
    font: verdana-11px-rounded
    visible: false

  Button
    id: deleteRankBtn
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 50 20
    text: Delete
    font: verdana-11px-rounded
    color: #cc6666
    visible: false

GuildInviteRow < Panel
  height: 28
  margin-bottom: 2
  border-width: 1
  border-color: #303030
  background-color: #1c1c1c

  Label
    id: guildName
    anchors.left: parent.left
    anchors.right: acceptBtn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-rounded
    color: #dfdfdf
    phantom: true

  Button
    id: acceptBtn
    anchors.right: declineBtn.left
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 2
    size: 58 20
    text: Accept
    font: verdana-11px-rounded
    color: #66cc66

  Button
    id: declineBtn
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-right: 6
    size: 58 20
    text: Decline
    font: verdana-11px-rounded
    color: #cc6666

GuildInvitedRow < Panel
  height: 24
  margin-bottom: 2
  border-width: 1
  border-color: #2a2a2a
  background-color: #1c1c1c

  Label
    id: inviteeName
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 10
    font: verdana-11px-rounded
    color: #a8b8c8
    phantom: true

GuildActivityRow < Label
  height: 16
  font: verdana-11px-rounded
  color: #7aadca
  margin-top: 2
  margin-bottom: 1
  margin-left: 8

GuildNoGuildPanel < Panel
  height: 50
  Label
    id: messageLabel
    anchors.fill: parent
    margin: 8
    font: verdana-11px-rounded
    color: #a0a0a0
    phantom: true

GuildInputWindow < MainWindow
  !text: tr('Guild')
  size: 300 110
  @onEscape: self:destroy()

  Label
    id: windowTitle
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-bottom: 4
    font: verdana-11px-rounded
    color: #dfdfdf

  TextEdit
    id: inputField
    anchors.top: windowTitle.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    height: 20
    font: verdana-11px-rounded
    max-length: 30

  Button
    id: okBtn
    anchors.bottom: parent.bottom
    anchors.right: cancelBtn.left
    margin-right: 4
    size: 60 20
    text: OK

  Button
    id: cancelBtn
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    size: 60 20
    text: Cancel

MainWindow
  id: guildWindow
  !text: tr('Guild')
  size: 720 500
  @onEscape: modules.game_guild.hide()

  Label
    id: guildNameLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: refreshBtn.left
    margin-top: 2
    margin-right: 4
    height: 16
    font: verdana-11px-rounded
    color: #c0a060

  Button
    id: refreshBtn
    anchors.top: parent.top
    anchors.right: parent.right
    size: 60 16
    text: Refresh
    font: verdana-11px-rounded

  Panel
    id: guildTabsRow
    anchors.top: guildNameLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    height: 24
    margin-top: 4
    visible: true

    Button
      id: infoTab
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 82 22
      text: Info
      font: verdana-11px-rounded
      checkable: true
      checked: true
      @onClick: modules.game_guild.switchTab('infoTab')

    Button
      id: membersTab
      anchors.left: infoTab.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      size: 82 22
      text: Members
      font: verdana-11px-rounded
      checkable: true
      @onClick: modules.game_guild.switchTab('membersTab')

    Button
      id: invitesTab
      anchors.left: membersTab.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      size: 82 22
      text: Invites
      font: verdana-11px-rounded
      checkable: true
      @onClick: modules.game_guild.switchTab('invitesTab')

    Button
      id: ranksTab
      anchors.left: invitesTab.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      size: 82 22
      text: Ranks
      font: verdana-11px-rounded
      checkable: true
      @onClick: modules.game_guild.switchTab('ranksTab')

    Button
      id: activityTab
      anchors.left: ranksTab.right
      anchors.verticalCenter: parent.verticalCenter
      margin-left: 2
      size: 82 22
      text: Activity
      font: verdana-11px-rounded
      checkable: true
      @onClick: modules.game_guild.switchTab('activityTab')
  Panel
    id: infoPanel
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      margin-left: 4
      height: 14
      text: Guild:
      font: verdana-11px-rounded
      color: #a0a0a0
      text-auto-resize: true

    Label
      id: infoGuildName
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 50
      height: 14
      font: verdana-11px-rounded
      color: #dfdfdf

    Label
      anchors.top: infoGuildName.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 4
      height: 14
      text: Leader:
      font: verdana-11px-rounded
      color: #a0a0a0
      text-auto-resize: true

    Label
      id: infoOwnerName
      anchors.top: infoGuildName.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 60
      height: 14
      font: verdana-11px-rounded
      color: #dfdfdf

    Label
      anchors.top: infoOwnerName.bottom
      anchors.left: parent.left
      margin-top: 4
      margin-left: 4
      height: 14
      text: Members:
      font: verdana-11px-rounded
      color: #a0a0a0
      text-auto-resize: true

    Label
      id: infoMemberCount
      anchors.top: infoOwnerName.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 72
      height: 14
      font: verdana-11px-rounded
      color: #dfdfdf

    Label
      id: motdTitleLabel
      anchors.top: infoMemberCount.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 4
      height: 14
      text: Message of the Day:
      font: verdana-11px-rounded
      color: #a0a0a0

    MultilineTextEdit
      id: motdEdit
      anchors.top: motdTitleLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      height: 80
      margin-top: 2
      font: verdana-11px-rounded
      max-length: 255

    Button
      id: saveMotdBtn
      anchors.top: motdEdit.bottom
      anchors.right: parent.right
      margin-top: 4
      margin-right: 4
      size: 80 20
      text: Save MOTD
      font: verdana-11px-rounded
      visible: false

    Button
      id: leaveGuildBtn
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 4
      margin-left: 4
      size: 100 22
      text: Leave Guild
      font: verdana-11px-rounded
      color: #cc9944
      visible: false

    Button
      id: disbandGuildBtn
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-bottom: 4
      margin-left: 4
      size: 110 22
      text: Disband Guild
      font: verdana-11px-rounded
      color: #cc4444
      visible: false

  Panel
    id: membersPanelWrapper
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 2
      margin-left: 4
      height: 20
      text: Invite:
      font: verdana-11px-rounded
      color: #a0a0a0
      text-auto-resize: true

    TextEdit
      id: inviteNameField
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: inviteBtn.left
      margin-top: 2
      margin-left: 50
      margin-right: 4
      height: 20
      font: verdana-11px-rounded
      max-length: 30

    Button
      id: inviteBtn
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 2
      margin-right: 4
      size: 60 20
      text: Invite
      font: verdana-11px-rounded
      visible: false

    TextEdit
      id: memberSearchField
      anchors.top: inviteNameField.bottom
      anchors.left: parent.left
      anchors.right: memberSortBox.left
      margin-top: 4
      margin-left: 4
      margin-right: 4
      height: 20
      font: verdana-11px-rounded
      max-length: 30
      text: 

    ComboBox
      id: memberSortBox
      anchors.top: inviteNameField.bottom
      anchors.right: memberOnlineOnlyCheck.left
      margin-top: 4
      margin-right: 4
      size: 120 20
      font: verdana-11px-rounded

    CheckBox
      id: memberOnlineOnlyCheck
      anchors.top: inviteNameField.bottom
      anchors.right: parent.right
      margin-top: 6
      margin-right: 4
      size: 80 16
      text: Online
      font: verdana-11px-rounded
      checked: false

    VerticalScrollBar
      id: membersScrollBar
      anchors.top: memberSearchField.bottom
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 4
      width: 10

    Panel
      id: membersListPanel
      anchors.top: memberSearchField.bottom
      anchors.left: parent.left
      anchors.right: membersScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 4
      layout:
        type: verticalBox
        spacing: 0
      vertical-scrollbar: membersScrollBar

  Panel
    id: invitesPanelWrapper
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 4
      height: 14
      text: Players with pending invitations to your guild:
      font: verdana-11px-rounded
      color: #a0a0a0

    VerticalScrollBar
      id: invitesScrollBar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 20
      width: 10

    Panel
      id: invitesListPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: invitesScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 20
      layout:
        type: verticalBox
        spacing: 0
      vertical-scrollbar: invitesScrollBar

  Panel
    id: ranksPanelWrapper
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 4
      height: 14
      text: Guild Ranks:
      font: verdana-11px-rounded
      color: #a0a0a0

    Button
      id: addRankBtn
      anchors.top: parent.top
      anchors.right: parent.right
      margin-top: 2
      margin-right: 4
      size: 90 18
      text: + Add Rank
      font: verdana-11px-rounded
      visible: false

    Label
      id: rankPermTitle
      anchors.top: parent.top
      anchors.left: parent.left
      margin-top: 22
      margin-left: 4
      height: 14
      text: Rank Permissions:
      font: verdana-11px-rounded
      color: #a0a0a0

    ComboBox
      id: rankPermTargetBox
      anchors.top: rankPermTitle.bottom
      anchors.left: parent.left
      anchors.right: rankPermSaveBtn.left
      margin-top: 2
      margin-left: 4
      margin-right: 4
      height: 20
      font: verdana-11px-rounded

    Button
      id: rankPermSaveBtn
      anchors.top: rankPermTitle.bottom
      anchors.right: parent.right
      margin-top: 2
      margin-right: 4
      size: 64 20
      text: Save
      font: verdana-11px-rounded
      visible: false

    CheckBox
      id: permInviteCheck
      anchors.top: rankPermTargetBox.bottom
      anchors.left: parent.left
      margin-top: 3
      margin-left: 4
      size: 100 16
      text: Invite
      font: verdana-11px-rounded

    CheckBox
      id: permKickCheck
      anchors.top: rankPermTargetBox.bottom
      anchors.left: permInviteCheck.right
      margin-top: 3
      margin-left: 6
      size: 80 16
      text: Kick
      font: verdana-11px-rounded

    CheckBox
      id: permMotdCheck
      anchors.top: rankPermTargetBox.bottom
      anchors.left: permKickCheck.right
      margin-top: 3
      margin-left: 6
      size: 90 16
      text: MOTD
      font: verdana-11px-rounded

    CheckBox
      id: permRanksCheck
      anchors.top: rankPermTargetBox.bottom
      anchors.left: permMotdCheck.right
      margin-top: 3
      margin-left: 6
      size: 110 16
      text: Ranks
      font: verdana-11px-rounded

    CheckBox
      id: permTitleCheck
      anchors.top: rankPermTargetBox.bottom
      anchors.left: permRanksCheck.right
      margin-top: 3
      margin-left: 6
      size: 80 16
      text: Titles
      font: verdana-11px-rounded

    VerticalScrollBar
      id: ranksScrollBar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 84
      width: 10

    Panel
      id: ranksListPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: ranksScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 84
      layout:
        type: verticalBox
        spacing: 2
      vertical-scrollbar: ranksScrollBar

  Panel
    id: activityPanelWrapper
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 2
      margin-left: 4
      height: 14
      text: Recent Guild Activity:
      font: verdana-11px-rounded
      color: #a0a0a0

    VerticalScrollBar
      id: activityScrollBar
      anchors.top: parent.top
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 20
      width: 10

    Panel
      id: activityListPanel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: activityScrollBar.left
      anchors.bottom: parent.bottom
      margin-top: 20
      layout:
        type: verticalBox
        spacing: 0
      vertical-scrollbar: activityScrollBar

  Panel
    id: noGuildWrapper
    anchors.top: guildTabsRow.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 6
    visible: false

    Label
      id: noGuildInfoLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 8
      height: 30
      text: You are not in a guild. Create one below or accept an invitation.
      font: verdana-11px-rounded
      color: #a0a0a0

    Label
      id: noGuildTipsLabel
      anchors.top: noGuildInfoLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      margin-left: 8
      height: 36
      text: Tip: Use Guild Manager in top menu for invites and management.\nFounding is only available through a Guildmaster.
      font: verdana-11px-rounded
      color: #888888

    Panel
      id: createGuildPanel
      anchors.top: noGuildTipsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 4
      height: 40

      Label
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        text: Guild Name:
        font: verdana-11px-rounded
        color: #a0a0a0
        text-auto-resize: true

      TextEdit
        id: guildNameField
        anchors.left: parent.left
        anchors.right: createGuildBtn.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 80
        margin-right: 4
        height: 20
        font: verdana-11px-rounded
        max-length: 30

      Button
        id: createGuildBtn
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-right: 8
        size: 100 22
        text: Found Guild
        font: verdana-11px-rounded

    Panel
      id: tabContent
      anchors.top: noGuildTipsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      margin-top: 48
      layout:
        type: verticalBox
        spacing: 0
