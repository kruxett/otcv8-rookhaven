BoatFareWindow < MainWindow
  id: boatFareWindow
  !text: tr('Boat Fare')
  size: 300 140
  @onEscape: modules.game_boatfare.decline()

  Label
    id: destinationLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #c8a456
    margin-top: 2
    height: 20

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 4

  Label
    id: priceLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    margin-top: 8
    height: 20

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 6

  Panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    layout: horizontalBox
      align-right: true
      spacing: 6
    margin-bottom: 2
    margin-right: 4

    Button
      id: acceptButton
      !text: tr('Accept')
      width: 64
      @onClick: modules.game_boatfare.accept()

    Button
      id: declineButton
      !text: tr('Decline')
      width: 64
      @onClick: modules.game_boatfare.decline()
