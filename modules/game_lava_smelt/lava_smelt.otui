LavaSmeltSlot < Panel
  height: 54
  image-source: /images/ui/panel_content
  image-border: 3

  Panel
    id: itemFrame
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 42 42
    image-source: /images/ui/item.png
    border-width: 1
    border-color: #5a5040

  UIItem
    id: item
    anchors.fill: itemFrame
    virtual: true
    selectable: false
    draggable: false
    phantom: true

  Label
    id: nameLabel
    anchors.left: itemFrame.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 10
    margin-right: 8
    margin-top: 8
    height: 15
    text: Drop a rarity item here

  Label
    id: tierLabel
    anchors.left: nameLabel.left
    anchors.right: parent.right
    anchors.top: nameLabel.bottom
    margin-top: 4
    height: 14
    text: Right-click to clear this slot
    color: #9e9080

MainWindow
  id: lavaSmeltWindow
  !text: tr('Lava Forge')
  size: 460 480
  @onEscape: modules.game_lava_smelt.close()

  Label
    id: introLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    margin-right: 10
    height: 28
    text-wrap: true
    text-auto-resize: true
    color: #d7c28e
    text: Drop up to 6 rare, epic, or legendary items into the forge. Smelting destroys them and returns reroll materials.

  HorizontalSeparator
    anchors.top: introLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 8

  Label
    id: slotsLabel
    anchors.top: introLabel.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 12
    height: 14
    text: Smelting Queue
    color: #e1d3a1

  Panel
    id: slotsPanel
    anchors.top: slotsLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 8
    height: 334
    layout:
      type: verticalBox
      spacing: 4

    LavaSmeltSlot
      id: slot1
    LavaSmeltSlot
      id: slot2
    LavaSmeltSlot
      id: slot3
    LavaSmeltSlot
      id: slot4
    LavaSmeltSlot
      id: slot5
    LavaSmeltSlot
      id: slot6

  HorizontalSeparator
    anchors.top: slotsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 8
    margin-right: 8

  Label
    id: selectedCountLabel
    anchors.top: slotsPanel.bottom
    anchors.left: parent.left
    margin-top: 14
    margin-left: 12
    height: 14
    text: Selected: 0 / 6

  Label
    id: goldCostLabel
    anchors.top: selectedCountLabel.bottom
    anchors.left: selectedCountLabel.left
    margin-top: 4
    height: 14
    text: Gold Fee: 0
    color: #d0b060

  Label
    id: rarityBreakdownLabel
    anchors.top: goldCostLabel.bottom
    anchors.left: selectedCountLabel.left
    anchors.right: parent.right
    margin-top: 4
    margin-right: 12
    height: 14
    text: Rare: 0  Epic: 0  Legendary: 0
    color: #9e9080

  Label
    id: statusLabel
    anchors.top: rarityBreakdownLabel.bottom
    anchors.left: selectedCountLabel.left
    anchors.right: parent.right
    margin-top: 6
    margin-right: 12
    height: 30
    text-wrap: true
    text-auto-resize: true
    color: #d9d2bf
    text: The forge accepts only rarity gear.

  Label
    id: resultLabel
    anchors.top: statusLabel.bottom
    anchors.left: selectedCountLabel.left
    anchors.right: parent.right
    margin-top: 4
    margin-right: 12
    height: 34
    text-wrap: true
    text-auto-resize: true
    color: #cdbb91
    text: 

  Button
    id: clearButton
    anchors.bottom: parent.bottom
    anchors.left: parent.left
    margin-left: 10
    margin-bottom: 10
    size: 100 24
    text: Clear

  Button
    id: smeltButton
    anchors.bottom: parent.bottom
    anchors.right: closeButton.left
    margin-right: 6
    margin-bottom: 10
    size: 100 24
    text: Smelt

  Button
    id: closeButton
    anchors.bottom: parent.bottom
    anchors.right: parent.right
    margin-right: 10
    margin-bottom: 10
    size: 100 24
    text: Close