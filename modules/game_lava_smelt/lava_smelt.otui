LavaSmeltSlot < Panel
  height: 50
  image-source: /images/ui/panel_content
  image-border: 3

  Panel
    id: itemFrame
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    size: 42 42
    image-source: /images/ui/item.png
    border-width: 1
    border-color: #5a5040

  UIItem
    id: item
    anchors.fill: itemFrame
    virtual: true
    selectable: false
    draggable: false
    phantom: true

  Label
    id: nameLabel
    anchors.left: itemFrame.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 10
    margin-right: 8
    margin-top: 8
    height: 15
    text: Place a rarity item here

  Label
    id: tierLabel
    anchors.left: nameLabel.left
    anchors.right: parent.right
    anchors.top: nameLabel.bottom
    margin-top: 4
    height: 14
    text: Right-click to remove this offering
    color: #9e9080

ForgottenRecipeButton < UIButton
  height: 36
  image-source: /images/ui/panel_content
  image-border: 3
  color: #c0c0c0
  image-color: #b4b4b4
  $hover !on:
    image-color: #d0d0d0
  $on:
    image-color: #e1d3a1
  UIItem
    id: item
    size: 32 32
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 3
    virtual: true
    draggable: false
    phantom: true
  Label
    id: nameLabel
    anchors.left: item.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 8
    margin-right: 6
    margin-top: 4
    height: 14
    phantom: true
  Label
    id: stateLabel
    anchors.left: nameLabel.left
    anchors.right: nameLabel.right
    anchors.top: nameLabel.bottom
    margin-top: 2
    height: 13
    color: #9e9080
    phantom: true

ForgottenScrollBar < VerticalScrollBar
  visible: true
  $!on:
    visible: false

ForgottenMaterialRow < Panel
  height: 22
  UIItem
    id: item
    size: 20 20
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    virtual: true
    draggable: false
    phantom: true
  Label
    id: nameLabel
    anchors.left: item.right
    anchors.right: amountLabel.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 6
    margin-right: 5
    height: 14
    phantom: true
  Label
    id: amountLabel
    anchors.right: parent.right
    anchors.verticalCenter: parent.verticalCenter
    width: 92
    height: 14
    text-align: right
    phantom: true

MainWindow
  id: lavaSmeltWindow
  !text: tr('Lava Forge')
  size: 640 600
  @onEscape: modules.game_lava_smelt.close()

  Panel
    id: tabBar
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    height: 23
    margin-left: 8
    margin-right: 8
    TabButton
      id: smeltTab
      anchors.top: parent.top
      anchors.left: parent.left
      size: 138 23
      text: Smelting
      on: true
    TabButton
      id: forgottenTab
      anchors.top: parent.top
      anchors.left: smeltTab.right
      margin-left: 3
      size: 150 23
      text: Forgotten Works

  Panel
    id: smeltPanel
    anchors.top: tabBar.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    margin-top: 3
    Label
      id: introLabel
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 10
      margin-right: 10
      height: 28
      text-wrap: true
      text-auto-resize: true
      color: #d7c28e
      text: Place up to 6 rare, epic, or legendary items into the forge. The rite consumes them and returns tempering materials.

    HorizontalSeparator
      anchors.top: introLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 8
      margin-right: 8

    Label
      id: slotsLabel
      anchors.top: introLabel.bottom
      anchors.left: parent.left
      margin-top: 14
      margin-left: 12
      height: 14
      text: Forge Offerings
      color: #e1d3a1

    Panel
      id: slotsPanel
      anchors.top: slotsLabel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 6
      margin-left: 8
      margin-right: 8
      height: 310
      layout:
        type: verticalBox
        spacing: 4

      LavaSmeltSlot
        id: slot1
      LavaSmeltSlot
        id: slot2
      LavaSmeltSlot
        id: slot3
      LavaSmeltSlot
        id: slot4
      LavaSmeltSlot
        id: slot5
      LavaSmeltSlot
        id: slot6

    HorizontalSeparator
      anchors.top: slotsPanel.bottom
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 8
      margin-left: 8
      margin-right: 8

    Label
      id: selectedCountLabel
      anchors.top: slotsPanel.bottom
      anchors.left: parent.left
      margin-top: 14
      margin-left: 12
      height: 14
      text: Offerings: 0 / 6

    Label
      id: goldCostLabel
      anchors.top: selectedCountLabel.bottom
      anchors.left: selectedCountLabel.left
      anchors.right: parent.right
      margin-top: 4
      margin-right: 12
      height: 14
      text: Forging Due: 0
      color: #d0b060

    Label
      id: rarityBreakdownLabel
      anchors.top: goldCostLabel.bottom
      anchors.left: selectedCountLabel.left
      anchors.right: parent.right
      margin-top: 4
      margin-right: 12
      height: 14
      text: Rare: 0  Epic: 0  Legendary: 0
      color: #9e9080

    Label
      id: statusLabel
      anchors.top: rarityBreakdownLabel.bottom
      anchors.left: selectedCountLabel.left
      anchors.right: parent.right
      margin-top: 6
      margin-right: 12
      height: 30
      text-wrap: true
      text-auto-resize: true
      color: #d9d2bf
      text: The forge accepts only rare, epic, or legendary gear.

    Label
      id: resultLabel
      anchors.top: statusLabel.bottom
      anchors.left: selectedCountLabel.left
      anchors.right: parent.right
      margin-top: 4
      margin-right: 12
      height: 24
      text-wrap: true
      text-auto-resize: true
      color: #cdbb91
      text:

    Button
      id: clearButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-bottom: 10
      size: 100 24
      text: Clear Offerings

    Button
      id: smeltButton
      anchors.bottom: parent.bottom
      anchors.right: closeButton.left
      margin-right: 6
      margin-bottom: 10
      size: 100 24
      text: Smelt

    Button
      id: closeButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 10
      margin-bottom: 10
      size: 100 24
      text: Close

  Panel
    id: forgottenPanel
    anchors.fill: smeltPanel
    visible: false
    Label
      id: forgottenIntro
      anchors.top: parent.top
      anchors.left: parent.left
      anchors.right: parent.right
      margin-top: 10
      margin-left: 10
      margin-right: 10
      height: 16
      text: Choose a discovered design, then add its Epic base weapon.
      color: #d7c28e
    Label
      id: forgottenDesignsLabel
      anchors.top: forgottenIntro.bottom
      anchors.left: forgottenIntro.left
      width: 206
      margin-top: 10
      height: 16
      text: Designs
      color: #e1d3a1
    UIScrollArea
      id: forgottenRecipes
      anchors.top: forgottenDesignsLabel.bottom
      anchors.left: forgottenIntro.left
      anchors.bottom: forgottenUnlockButton.top
      width: 206
      margin-top: 4
      margin-bottom: 8
      vertical-scrollbar: forgottenRecipesScrollbar
      layout:
        type: verticalBox
        spacing: 2
    ForgottenScrollBar
      id: forgottenRecipesScrollbar
      anchors.top: forgottenRecipes.top
      anchors.bottom: forgottenRecipes.bottom
      anchors.left: forgottenRecipes.right
      margin-left: 2
      step: 38
      pixel-scroll: true
    Button
      id: forgottenUnlockButton
      anchors.left: forgottenIntro.left
      anchors.bottom: forgottenStatus.top
      margin-bottom: 10
      size: 206 24
      text: Unlock designs
    UIScrollArea
      id: forgottenDetails
      anchors.top: forgottenDesignsLabel.top
      anchors.left: forgottenRecipesScrollbar.right
      anchors.right: parent.right
      anchors.bottom: forgottenStatus.top
      margin-left: 12
      margin-right: 24
      margin-bottom: 10
      vertical-scrollbar: forgottenDetailsScrollbar
      UIItem
        id: forgottenDonor
        anchors.top: parent.top
        anchors.left: parent.left
        size: 42 42
        image-source: /images/ui/item.png
        border-width: 1
        border-color: #5a5040
        virtual: true
        draggable: false
        tooltip: Drop the matching Epic weapon here. Right-click to remove it.
      Label
        id: forgottenName
        anchors.top: parent.top
        anchors.left: forgottenDonor.right
        anchors.right: parent.right
        margin-left: 8
        height: 18
        color: #e1d3a1
        text: No discovered designs
      Label
        id: forgottenDescription
        anchors.top: forgottenName.bottom
        anchors.left: forgottenName.left
        anchors.right: parent.right
        height: 28
        text-wrap: true
        text-auto-resize: true
        color: #b8a7ff
      Label
        id: forgottenStats
        anchors.top: forgottenDescription.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 12
        height: 44
        text-wrap: true
        text-auto-resize: true
        phantom: false
        color: #c0c0c0
      Button
        id: forgottenWeaponDetailsButton
        anchors.top: forgottenStats.bottom
        anchors.left: parent.left
        margin-top: 5
        size: 120 22
        text: Weapon details
        enabled: false
      HorizontalSeparator
        id: forgottenWeaponSeparator
        anchors.top: forgottenWeaponDetailsButton.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 10
      Label
        id: forgottenSignature
        anchors.top: forgottenWeaponDetailsButton.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 18
        height: 16
        phantom: false
        color: #d7c28e
      Label
        id: forgottenEffect
        anchors.top: forgottenSignature.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 70
        text-wrap: true
        text-auto-resize: true
        color: #c0c0c0
      Button
        id: forgottenEffectDetailsButton
        anchors.top: forgottenEffect.bottom
        anchors.left: parent.left
        margin-top: 5
        size: 120 22
        text: Signature details
        enabled: false
      Label
        id: forgottenMaterialsLabel
        anchors.top: forgottenEffectDetailsButton.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 18
        height: 16
        text: Costs (owned / required)
        phantom: false
        color: #e1d3a1
      Panel
        id: forgottenMaterials
        anchors.top: forgottenMaterialsLabel.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        height: 0
        layout:
          type: verticalBox
          spacing: 1
      Label
        id: forgottenRule
        anchors.top: forgottenMaterials.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 14
        height: 58
        text-wrap: true
        text-auto-resize: true
        phantom: false
        color: #9e9080
      Button
        id: forgottenActivityDetailsButton
        anchors.top: forgottenRule.bottom
        anchors.left: parent.left
        margin-top: 5
        margin-bottom: 8
        size: 120 22
        text: Forge activity
        enabled: false
    ForgottenScrollBar
      id: forgottenDetailsScrollbar
      anchors.top: forgottenDetails.top
      anchors.bottom: forgottenDetails.bottom
      anchors.right: parent.right
      margin-right: 10
      step: 40
      pixel-scroll: true
    HorizontalSeparator
      anchors.bottom: forgottenStatus.top
      anchors.left: forgottenIntro.left
      anchors.right: forgottenIntro.right
      margin-bottom: 4
    Label
      id: forgottenStatus
      anchors.bottom: forgottenRefreshButton.top
      anchors.left: forgottenIntro.left
      anchors.right: forgottenIntro.right
      margin-bottom: 8
      height: 28
      text-wrap: true
      phantom: false
      color: #9e9080
      text: Discover a design to begin.
    Button
      id: forgottenRefreshButton
      anchors.bottom: parent.bottom
      anchors.left: parent.left
      margin-left: 10
      margin-bottom: 10
      size: 100 24
      text: Refresh
    Button
      id: forgottenCraftButton
      anchors.bottom: parent.bottom
      anchors.right: forgottenCloseButton.left
      margin-right: 6
      margin-bottom: 10
      size: 100 24
      text: Forge
      enabled: false
    Button
      id: forgottenCloseButton
      anchors.bottom: parent.bottom
      anchors.right: parent.right
      margin-right: 10
      margin-bottom: 10
      size: 100 24
      text: Close
      @onClick: modules.game_lava_smelt.close()
