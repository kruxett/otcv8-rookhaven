TradepackCategoryHeader < Label
  height: 18
  margin-top: 8
  margin-bottom: 2
  padding-left: 6
  font: verdana-11px-rounded
  color: #aa99cc
  text-align: left
  phantom: true
  focusable: false

TradepackTierRow < Panel
  height: 44
  margin-bottom: 3
  border-width: 1
  border-color: #000000
  background-color: #232323
  focusable: true

  $hover:
    border-color: #555555

  TradepackTierRow.unaffordable:
    background-color: #141414
    border-color: #1e1e1e
    $hover:
      border-color: #1e1e1e

  UIItem
    id: crateIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    size: 32 32
    virtual: true
    selectable: false
    draggable: false

  Label
    id: rowTitle
    anchors.left: crateIcon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    margin-right: 6
    margin-top: 7
    height: 14
    font: verdana-11px-rounded
    phantom: true

  Label
    id: rowSub
    anchors.left: crateIcon.right
    anchors.right: parent.right
    anchors.top: rowTitle.bottom
    margin-left: 5
    margin-right: 6
    margin-top: 2
    height: 12
    color: #b0b0b0
    font: verdana-11px-rounded
    phantom: true

MainWindow
  id: tradepackSelectWindow
  !text: tr('Tradepack Order')
  size: 540 340
  movable: false
  @onEscape: modules.game_tradepack.cancel()

  FlatPanel
    id: contentPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: bottomBar.top
    margin-bottom: 4

    // Left column: pack size list (scrollable)
    Panel
      id: listContainer
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: destRow.top
      width: 204
      margin-left: 4
      margin-top: 4
      margin-bottom: 4

      ScrollablePanel
        id: listPanel
        anchors.left: parent.left
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: listScrollbar.left
        layout:
          type: verticalBox
          spacing: 0
        vertical-scrollbar: listScrollbar

      VerticalScrollBar
        id: listScrollbar
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        anchors.right: parent.right
        width: 8
        step: 47
        pixels-scroll: true

    // Vertical divider
    VerticalSeparator
      id: divider
      anchors.left: listContainer.right
      anchors.top: parent.top
      anchors.bottom: destRow.top
      margin-left: 2
      margin-right: 2

    // Right column: details for selected tier
    FlatPanel
      id: detailPanel
      anchors.left: divider.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: destRow.top
      margin-left: 4
      margin-right: 4
      margin-top: 4
      margin-bottom: 4

      Label
        id: detailTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 8
        margin-left: 8
        margin-right: 8
        font: verdana-11px-monochrome
        color: #c8a456
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailWeight
        anchors.top: detailTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 3
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #888888
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailCost
        anchors.top: detailWeight.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailReward
        anchors.top: detailCost.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #70d870
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailSpeed
        anchors.top: detailReward.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #aaaaaa
        text-wrap: true
        text-auto-resize: true

    // Delivery info row at the bottom of the FlatPanel
    Panel
      id: destRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 44
      margin-bottom: 4

      Label
        id: deliveryLabel
        anchors.left: parent.left
        anchors.right: parent.right
        anchors.top: parent.top
        anchors.bottom: parent.bottom
        margin-left: 8
        margin-right: 8
        margin-top: 4
        margin-bottom: 4
        text-auto-resize: true
        text-wrap: true
        font: verdana-11px-monochrome
        color: #d0d0d0
        !text: tr('Deliverable at any tradepack dropoff point')

  Panel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    margin-bottom: 2

    Button
      id: nextButton
      !text: tr('Next')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 5
      @onClick: modules.game_tradepack.requestPack()

    Button
      id: cancelButton
      !text: tr('Cancel')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 5
      @onClick: modules.game_tradepack.cancel()
