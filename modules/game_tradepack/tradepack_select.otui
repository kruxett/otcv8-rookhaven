-- ============================================================
-- Stage 1: size + destination picker
-- ============================================================

MainWindow
  id: tradepackSelectWindow
  !text: tr('Tradepack')
  size: 340 300
  @onEscape: modules.game_tradepack.cancel()

  -- Title hint
  Label
    id: hintLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #c8a456
    margin-top: 2
    height: 18
    !text: tr('Choose pack size and destination')

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 4

  -- Section: Size
  Label
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 6
    margin-left: 8
    font: verdana-11px-monochrome
    color: #aaaaaa
    height: 14
    !text: tr('Pack Size')

  RadioButtonGroup
    id: tierGroup
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 8
    margin-right: 8
    layout:
      type: verticalBox
      spacing: 2
    -- buttons populated dynamically in tradepack.lua

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: prev.bottom
    margin-top: 8

  -- Section: Destination
  Label
    anchors.top: prev.bottom
    anchors.left: parent.left
    margin-top: 6
    margin-left: 8
    font: verdana-11px-monochrome
    color: #aaaaaa
    height: 14
    !text: tr('Destination')

  RadioButtonGroup
    id: destGroup
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 8
    margin-right: 8
    layout:
      type: verticalBox
      spacing: 2
    -- buttons populated dynamically

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 6

  Panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    margin-bottom: 2

    Button
      id: requestButton
      !text: tr('Next')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 5
      @onClick: modules.game_tradepack.requestPack()

    Button
      id: cancelButton
      !text: tr('Cancel')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 5
      @onClick: modules.game_tradepack.cancel()

-- ============================================================
-- Reusable radio button style for tradepack picker
-- ============================================================
RadioButton < RadioButton
  id: TradepackRadioButton
  height: 28
  font: verdana-11px-monochrome
  text-align: left
  padding-left: 4
