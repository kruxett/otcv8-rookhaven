MainWindow
  id: tradepackSelectWindow
  !text: tr('Tradepack')
  size: 330 180
  @onEscape: modules.game_tradepack.cancel()

  Label
    id: hintLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #c8a456
    margin-top: 4
    height: 18
    !text: tr('Select pack size and destination')

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: hintLabel.bottom
    margin-top: 4

  Label
    id: sizeLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    height: 14
    font: verdana-11px-monochrome
    color: #d0d0d0
    !text: tr('Pack Size')

  ComboBox
    id: tierSelector
    anchors.top: sizeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    margin-top: 2
    text-offset: 5 2
    menu-scroll: true
    menu-height: 100

  Label
    id: destinationLabel
    anchors.top: tierSelector.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    height: 14
    font: verdana-11px-monochrome
    color: #d0d0d0
    !text: tr('Destination')

  ComboBox
    id: destSelector
    anchors.top: destinationLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    margin-top: 2
    text-offset: 5 2
    menu-scroll: true
    menu-height: 100

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: next.top
    margin-bottom: 6

  Panel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    margin-bottom: 2

    Button
      id: nextButton
      !text: tr('Next')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 5
      @onClick: modules.game_tradepack.requestPack()

    Button
      id: cancelButton
      !text: tr('Cancel')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 5
      @onClick: modules.game_tradepack.cancel()
