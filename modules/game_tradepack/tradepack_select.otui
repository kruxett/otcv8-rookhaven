TradepackTierRow < Panel
  height: 44
  margin-bottom: 3
  border-width: 1
  border-color: #000000
  background-color: #232323
  focusable: true

  $hover:
    border-color: #555555

  UIItem
    id: crateIcon
    anchors.left: parent.left
    anchors.verticalCenter: parent.verticalCenter
    margin-left: 5
    size: 32 32
    virtual: true
    selectable: false
    draggable: false
    phantom: true

  Label
    id: rowTitle
    anchors.left: crateIcon.right
    anchors.right: parent.right
    anchors.top: parent.top
    margin-left: 5
    margin-right: 6
    margin-top: 7
    height: 14
    font: verdana-11px-rounded
    phantom: true

  Label
    id: rowSub
    anchors.left: crateIcon.right
    anchors.right: parent.right
    anchors.top: rowTitle.bottom
    margin-left: 5
    margin-right: 6
    margin-top: 2
    height: 12
    color: #b0b0b0
    font: verdana-11px-rounded
    phantom: true

MainWindow
  id: tradepackSelectWindow
  !text: tr('Tradepack Order')
  size: 420 280
  @onEscape: modules.game_tradepack.cancel()

  FlatPanel
    id: contentPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: parent.top
    anchors.bottom: bottomBar.top
    margin-bottom: 4

    // Left column: pack size list
    Panel
      id: listPanel
      anchors.left: parent.left
      anchors.top: parent.top
      anchors.bottom: destRow.top
      width: 180
      margin-left: 4
      margin-right: 4
      margin-top: 4
      margin-bottom: 4
      layout:
        type: verticalBox
        spacing: 0

    // Vertical divider
    VerticalSeparator
      id: divider
      anchors.left: listPanel.right
      anchors.top: parent.top
      anchors.bottom: destRow.top
      margin-left: 2
      margin-right: 2

    // Right column: details for selected tier
    FlatPanel
      id: detailPanel
      anchors.left: divider.right
      anchors.right: parent.right
      anchors.top: parent.top
      anchors.bottom: destRow.top
      margin-left: 4
      margin-right: 4
      margin-top: 4
      margin-bottom: 4

      Label
        id: detailTitle
        anchors.top: parent.top
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        margin-left: 8
        margin-right: 8
        font: verdana-11px-monochrome
        color: #c8a456
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailCost
        anchors.top: detailTitle.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 6
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #e07070
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailReward
        anchors.top: detailCost.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #70d870
        text-wrap: true
        text-auto-resize: true

      Label
        id: detailSpeed
        anchors.top: detailReward.bottom
        anchors.left: parent.left
        anchors.right: parent.right
        margin-top: 4
        margin-left: 8
        margin-right: 8
        font: verdana-11px-rounded
        color: #aaaaaa
        text-wrap: true
        text-auto-resize: true

    // Destination row at the bottom of the FlatPanel
    Panel
      id: destRow
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.bottom: parent.bottom
      height: 28
      margin-bottom: 4

      Label
        id: destLabel
        anchors.left: parent.left
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 8
        text-auto-resize: true
        font: verdana-11px-monochrome
        color: #d0d0d0
        !text: tr('Destination:')

      ComboBox
        id: destSelector
        anchors.left: destLabel.right
        anchors.right: parent.right
        anchors.verticalCenter: parent.verticalCenter
        margin-left: 6
        margin-right: 8
        text-offset: 5 2
        menu-scroll: true
        menu-height: 100

  Panel
    id: bottomBar
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    margin-bottom: 2

    Button
      id: nextButton
      !text: tr('Next')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 5
      @onClick: modules.game_tradepack.requestPack()

    Button
      id: cancelButton
      !text: tr('Cancel')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 5
      @onClick: modules.game_tradepack.cancel()
