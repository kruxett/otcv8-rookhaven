// ============================================================
// Stage 2: confirm before committing materials
// ============================================================

MainWindow
  id: tradepackConfirmWindow
  !text: tr('Confirm Tradepack')
  size: 300 230
  @onEscape: modules.game_tradepack.cancel()

  Label
    id: sizeLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #c8a456
    margin-top: 8
    text-wrap: true
    text-auto-resize: true

  Label
    id: destLabel
    anchors.top: sizeLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    margin-top: 4
    text-wrap: true
    text-auto-resize: true

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.top: destLabel.bottom
    margin-top: 6

  Label
    id: costLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #e07070
    margin-top: 6
    text-wrap: true
    text-auto-resize: true

  Label
    id: rewardLabel
    anchors.top: costLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #70e070
    margin-top: 4
    text-wrap: true
    text-auto-resize: true

  Label
    id: slowLabel
    anchors.top: rewardLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    font: verdana-11px-monochrome
    color: #aaaaaa
    margin-top: 4
    text-wrap: true
    text-auto-resize: true

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: buttonsPanel.top
    margin-bottom: 6

  Panel
    id: buttonsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 28
    margin-bottom: 2

    Button
      id: confirmButton
      !text: tr('Confirm')
      width: 72
      anchors.verticalCenter: parent.verticalCenter
      anchors.horizontalCenter: parent.horizontalCenter
      @onClick: modules.game_tradepack.confirm()

    Button
      id: prevButton
      !text: tr('Prev')
      width: 64
      anchors.verticalCenter: parent.verticalCenter
      anchors.right: confirmButton.left
      margin-right: 6
      @onClick: modules.game_tradepack.prev()

    Button
      id: cancelButton
      !text: tr('Cancel')
      width: 72
      anchors.verticalCenter: parent.verticalCenter
      anchors.left: confirmButton.right
      margin-left: 6
      @onClick: modules.game_tradepack.cancel()
