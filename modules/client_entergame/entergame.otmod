Module
  name: client_entergame
  description: Manages enter game and character list windows
  author: edubart & otclient.ovh
  website: https://github.com/edubart/otclient
  scripts: [ entergame, characterlist, accountservices ]
  @onLoad: EnterGame.init() CharacterList.init() AccountServicesUI.init()
  @onUnload: AccountServicesUI.terminate() EnterGame.terminate() CharacterList.terminate()
  
  load-later:
    - game_things
    - game_features
