ForgingReqCard < Panel
  size: 98 76

  UIItem
    id: reqItemIcon
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    margin-top: 4
    size: 34 34
    virtual: true
    selectable: false
    draggable: false
    phantom: false

  Label
    id: reqCountLabel
    anchors.top: reqItemIcon.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 3
    height: 14
    text-align: center
    text: -

  Label
    id: reqNameLabel
    anchors.top: reqCountLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    height: 14
    text-align: center
    text: -
    color: #9e9080
