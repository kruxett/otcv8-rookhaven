MainWindow
  id: corruptedUpgradeWindow
  !text: tr('Forging Station')
  size: 460 468
  @onEscape: modules.game_corrupted_upgrade.decline()

  Label
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 10
    height: 14
    text: Item to Forge
    color: #e1d3a1

  Panel
    id: previewPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10
    height: 80

    Panel
      id: itemDropZone
      anchors.left: parent.left
      anchors.verticalCenter: parent.verticalCenter
      size: 46 46
      image-source: /images/ui/item.png
      border-width: 1
      border-color: #5a5040

    UIItem
      id: itemPreview
      anchors.fill: itemDropZone
      virtual: true
      selectable: false
      draggable: false
      border-width: 0
      phantom: true
      tooltip: Drag an inventory item here

    Label
      id: itemNameLabel
      anchors.left: itemDropZone.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 10
      margin-top: 6
      height: 16
      text: No item selected

    Label
      id: itemTypeLabel
      anchors.left: itemNameLabel.left
      anchors.right: parent.right
      anchors.top: itemNameLabel.bottom
      margin-top: 3
      height: 14
      text: -
      color: #9e9080

    Label
      id: tierLabel
      anchors.left: itemNameLabel.left
      anchors.right: parent.right
      anchors.top: itemTypeLabel.bottom
      margin-top: 3
      height: 14
      text: Tier: -

    Label
      id: rollsLabel
      anchors.left: itemNameLabel.left
      anchors.right: parent.right
      anchors.top: tierLabel.bottom
      margin-top: 3
      height: 14
      text: New rolls: -
      color: #cdbb91

  HorizontalSeparator
    id: reqSep
    anchors.top: previewPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  Label
    anchors.top: reqSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    height: 14
    text: Upgrade Requirements
    color: #e1d3a1

  Panel
    id: requirementsPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10
    height: 82

  HorizontalSeparator
    id: optSep
    anchors.top: requirementsPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  Button
    id: toggleAffixBoostButton
    anchors.top: optSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10
    height: 20
    text: + Corrupted Affix Imbuement
    tooltip: Spend Corrupted Fragments to steer your next affix roll toward a chosen stat. More fragments = stronger pull, but higher risk of failure.
    @onClick: modules.game_corrupted_upgrade.toggleAffixPanel()

  Panel
    id: optionalPanel
    anchors.top: toggleAffixBoostButton.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-left: 10
    margin-right: 10
    margin-top: 0
    height: 146
    visible: false

    UIItem
      id: corruptedFragmentIcon
      anchors.left: parent.left
      anchors.top: parent.top
      margin-top: 2
      margin-left: 2
      size: 32 32
      virtual: true
      selectable: false
      draggable: false
      phantom: true

    Label
      id: corruptedCountLabel
      anchors.left: corruptedFragmentIcon.right
      anchors.top: parent.top
      margin-top: 10
      margin-left: 6
      text: Fragments:

    TextEdit
      id: corruptedCountEdit
      anchors.left: corruptedCountLabel.right
      anchors.top: corruptedCountLabel.top
      margin-left: 8
      width: 80
      height: 18
      text: 1

    Label
      id: corruptedCountLimitLabel
      anchors.left: corruptedCountEdit.right
      anchors.top: corruptedCountLabel.top
      margin-left: 6
      text: / 20

    HorizontalScrollBar
      id: corruptedCountSlider
      anchors.left: corruptedCountEdit.left
      anchors.top: corruptedCountEdit.bottom
      width: 120
      margin-top: 4
      minimum: 0
      maximum: 0
      step: 1
      value: 0

    Label
      id: affixTargetLabel
      anchors.left: parent.left
      anchors.top: corruptedCountSlider.bottom
      margin-left: 2
      margin-top: 8
      text: Target affix:

    ComboBox
      id: affixSelector
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: affixTargetLabel.bottom
      margin-left: 2
      margin-right: 2
      margin-top: 4
      height: 18

    Label
      id: failChanceLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: affixSelector.bottom
      margin-left: 2
      margin-right: 2
      margin-top: 6
      text: Ruin risk: 0.0%

    Label
      id: successChanceLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: failChanceLabel.bottom
      margin-left: 2
      margin-right: 2
      margin-top: 2
      text: Forge success: 100.0%

    Label
      id: weightLabel
      anchors.left: parent.left
      anchors.right: parent.right
      anchors.top: successChanceLabel.bottom
      margin-left: 2
      margin-right: 2
      margin-top: 2
      text: Favored affix: -

    Label
      id: targetAffixChanceLabel
      visible: false

  HorizontalSeparator
    id: statusSep
    anchors.top: optionalPanel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 5

  Label
    id: statusLabel
    anchors.top: statusSep.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4
    margin-left: 10
    margin-right: 10
    height: 22
    text-wrap: true
    color: #d9d2bf
    text: Drop an item into the forge slot to begin.

  HorizontalSeparator
    anchors.top: statusLabel.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2

  Panel
    id: controlsPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-bottom: 4

    Button
      id: acceptButton
      !text: tr('Upgrade')
      width: 80
      anchors.right: parent.horizontalCenter
      margin-right: 6
      @onClick: modules.game_corrupted_upgrade.accept()

    Button
      id: declineButton
      !text: tr('Close')
      width: 80
      anchors.left: parent.horizontalCenter
      margin-left: 6
      @onClick: modules.game_corrupted_upgrade.decline()
