MainWindow
  id: corruptedUpgradeWindow
  !text: tr('Forging Upgrade')
  size: 440 470
  @onEscape: modules.game_corrupted_upgrade.decline()

  Label
    id: headlineLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    text: Samwell Upgrade Forge
    color: #b57ae0
    margin-top: 2
    height: 18

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  Label
    id: costsLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 8
    text: Requirements: -

  Label
    id: resourceLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 8
    margin-right: 8
    text: Your resources: -

  Label
    id: tierFlowLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 8
    margin-right: 8
    text: Path: Common -> Rare -> Epic -> Legendary
    color: #b8a8cf

  Label
    id: slotHintLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 8
    text: Drag the item you want to upgrade into the slot below.

  Panel
    id: previewPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: optionalPanel.top
    margin-top: 6
    margin-bottom: 6
    margin-left: 8
    margin-right: 8

    Panel
      id: itemDropZone
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 2
      margin-top: 4
      size: 32 32
      image-source: /images/ui/item.png
      border-width: 0

    UIItem
      id: itemPreview
      anchors.fill: itemDropZone
      virtual: true
      selectable: false
      draggable: false
      border-width: 0
      phantom: true
      tooltip: Drag an inventory item here

    Label
      id: itemNameLabel
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-right: 4
      margin-top: 4
      text: No item selected

    Label
      id: itemTypeLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: itemNameLabel.bottom
      margin-top: 3
      text: Type: -

    Label
      id: bonusPreviewLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: itemTypeLabel.bottom
      margin-top: 3
      height: 40
      text-wrap: true
      text: Upgrade: -

    Label
      id: selectedPathLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: bonusPreviewLabel.bottom
      margin-top: 2
      text: Source: none
      color: #9b9b9b
      visible: false

    Label
      id: tierLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: selectedPathLabel.bottom
      margin-top: 2
      text: Tier: -

    Label
      id: rollsLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: tierLabel.bottom
      margin-top: 2
      text: New rolls this upgrade: -

    Label
      id: reqHeaderLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: rollsLabel.bottom
      margin-top: 2
      text: Upgrade requirements:
      color: #cfc4df

    Label
      id: reqListLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: reqHeaderLabel.bottom
      margin-top: 2
      height: 82
      text-wrap: true
      text: -

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: optionalPanel.top
    margin-left: 8
    margin-right: 8
    margin-bottom: 6

  Panel
    id: optionalPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-left: 8
    margin-right: 8
    margin-bottom: 6
    height: 94

    CheckBox
      id: useCorruptedBox
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 2
      margin-top: 2
      text: Use Corrupted Fragments for weighting (optional)

    Label
      id: corruptedCountLabel
      anchors.left: parent.left
      anchors.top: useCorruptedBox.bottom
      margin-top: 4
      margin-left: 2
      text: Fragment count:

    TextEdit
      id: corruptedCountEdit
      anchors.left: corruptedCountLabel.right
      anchors.top: corruptedCountLabel.top
      margin-left: 6
      width: 52
      height: 18
      text: 1

    Label
      id: affixTargetLabel
      anchors.left: corruptedCountEdit.right
      anchors.top: corruptedCountLabel.top
      margin-left: 10
      text: Weighted affix:

    ComboBox
      id: affixSelector
      anchors.left: affixTargetLabel.right
      anchors.right: parent.right
      anchors.top: corruptedCountLabel.top
      margin-left: 6
      margin-right: 2
      height: 18

    Label
      id: failChanceLabel
      anchors.left: parent.left
      anchors.top: corruptedCountLabel.bottom
      margin-left: 2
      margin-top: 5
      text: Fail chance: 0.0%

    Label
      id: weightLabel
      anchors.left: failChanceLabel.right
      anchors.top: failChanceLabel.top
      margin-left: 14
      text: Weight multiplier: x1.00

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: controlsPanel.top
    margin-bottom: 6
    margin-left: 8
    margin-right: 8
    height: 32
    text-wrap: true
    color: #d6c9e8
    text: Drag an item into the slot, then press Upgrade.

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-bottom: 3

  Panel
    id: controlsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-bottom: 4

    Button
      id: acceptButton
      !text: tr('Upgrade')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 6
      @onClick: modules.game_corrupted_upgrade.accept()

    Button
      id: declineButton
      !text: tr('Close')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 6
      @onClick: modules.game_corrupted_upgrade.decline()
