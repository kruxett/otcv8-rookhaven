MainWindow
  id: corruptedUpgradeWindow
  !text: tr('Corrupted Upgrade')
  size: 390 304
  @onEscape: modules.game_corrupted_upgrade.decline()

  Label
    id: headlineLabel
    anchors.top: parent.top
    anchors.left: parent.left
    anchors.right: parent.right
    text-align: center
    text: Corrupted forge infusion
    color: #b57ae0
    margin-top: 2
    height: 18

  HorizontalSeparator
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 4

  Label
    id: costsLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 6
    margin-left: 8
    margin-right: 8
    text: Cost: 1 Corrupted Fragment + 1000 gold

  Label
    id: resourceLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 2
    margin-left: 8
    margin-right: 8
    text: Your resources: -

  Label
    id: slotHintLabel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    margin-top: 8
    margin-left: 8
    margin-right: 8
    text: Drag the item you want to upgrade into the slot below.

  Panel
    id: previewPanel
    anchors.top: prev.bottom
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-top: 6
    margin-bottom: 8
    margin-left: 8
    margin-right: 8

    Panel
      id: itemDropZone
      anchors.left: parent.left
      anchors.top: parent.top
      margin-left: 2
      margin-top: 4
      size: 32 32
      image-source: /images/ui/item.png
      border-width: 0

    UIItem
      id: itemPreview
      anchors.fill: itemDropZone
      virtual: true
      selectable: false
      draggable: false
      border-width: 0
      phantom: true
      tooltip: Drag an inventory item here

    Label
      id: itemNameLabel
      anchors.left: prev.right
      anchors.right: parent.right
      anchors.top: parent.top
      margin-left: 8
      margin-right: 4
      margin-top: 4
      text: No item selected

    Label
      id: itemTypeLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: itemNameLabel.bottom
      margin-top: 3
      text: Type: -

    Label
      id: bonusPreviewLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: itemTypeLabel.bottom
      margin-top: 3
      height: 30
      text-wrap: true
      text: Upgrade: -

    Label
      id: selectedPathLabel
      anchors.left: itemNameLabel.left
      anchors.right: itemNameLabel.right
      anchors.top: bonusPreviewLabel.bottom
      margin-top: 2
      text: Source: none
      color: #9b9b9b

  Label
    id: statusLabel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: controlsPanel.top
    margin-bottom: 8
    margin-left: 8
    margin-right: 8
    height: 28
    text-wrap: true
    color: #d6c9e8
    text: Drag an item into the slot, then press Upgrade.

  HorizontalSeparator
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: statusLabel.top
    margin-bottom: 4

  Panel
    id: controlsPanel
    anchors.left: parent.left
    anchors.right: parent.right
    anchors.bottom: parent.bottom
    height: 30
    margin-bottom: 4

    Button
      id: acceptButton
      !text: tr('Upgrade')
      width: 72
      anchors.right: parent.horizontalCenter
      margin-right: 6
      @onClick: modules.game_corrupted_upgrade.accept()

    Button
      id: declineButton
      !text: tr('Close')
      width: 72
      anchors.left: parent.horizontalCenter
      margin-left: 6
      @onClick: modules.game_corrupted_upgrade.decline()
