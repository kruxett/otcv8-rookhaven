GameButtonsWindow < HeadlessMiniWindow
  height: 26
  &forceOpen: true
  &autoOpen: 4

  Panel
    id: contentsPanel
    anchors.fill: parent
    margin-left: 3
    margin-bottom: 3
    margin-top: 18
    margin-right: 5
    padding-top: 2
    padding-bottom: 2
    
    Panel
      id: buttons
      anchors.fill: parent
      layout:
        type: grid
        cell-spacing: 3
        cell-size: 20 20
        flow: true