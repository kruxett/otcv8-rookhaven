-- Compatibility styles for game_cyclopedia port (opentibiabr -> rookhaven)

CheckBoxCircle < UICheckBox
  size: 12 12
  text-align: left
  text-offset: 18 -1
  image-rect: 0 0 12 12
  image-source: /images/ui/checkboxcircle
  change-cursor-image: true
  cursor: pointer

  $hover !disabled:
    color: #ffffff

  $!checked:
    image-clip: 0 0 12 12

  $checked:
    image-clip: 0 12 12 12

  $disabled:
    change-cursor-image: false

fakeCheckBox < UICheckBox
  font: cipsoftFont
  size: 106 23
  image-source: /images/ui/button
  image-clip: 0 0 22 23
  image-border: 3
  padding: 5 10 5 10
  opacity: 1.0
  color: #b9b9b9ff

  $hover !disabled:
    color: #ffffff

  $!checked:
    image-clip: 0 0 22 23

  $hover !checked:
    image-clip: 0 0 22 23

  $checked:
    image-clip: 0 46 22 23

  $hover checked:
    image-clip: 0 46 22 23

  $disabled:
    image-color: #dfdfdf88
    color: #dfdfdf88
    opacity: 0.8

CheckBoxButton < UICheckBox
  size: 106 23
  image-source: /images/ui/button-9grid-idle
  image-border: 3
  text-align: center
  padding: 5 10 5 10
  change-cursor-image: true
  cursor: pointer
  color: #BDBDBD

  $checked:
    image-source: /images/ui/button-9grid-pressed
    text-offset: 1 1

  $!checked:
    text-offset: 0 0

  $disabled:
    color: #dfdfdf88
    opacity: 0.8
    change-cursor-image: false

VerticalScrollBarQtSlider < UIButton
  id: sliderButton
  anchors.centerIn: parent
  size: 12 44
  image-source: /images/ui/scrollbar_new_vertical
  image-clip: 22 0 12 44
  image-border-top: 7
  image-border-bottom: 7

VerticalQtScrollBar < UIScrollBar
  orientation: vertical
  size: 10 78
  image-source: /images/ui/scrollbar_new_vertical
  image-clip: 0 0 10 78
  image-border: 2
  pixels-scroll: true
  parent-scroll: true

  UIButton
    id: decrementButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.top: parent.top
    image-source: /images/ui/scrollbar_new_vertical
    image-clip: 10 0 12 12
    size: 12 12
    $pressed:
      image-clip: 10 12 12 12

  UIButton
    id: incrementButton
    anchors.horizontalCenter: parent.horizontalCenter
    anchors.bottom: parent.bottom
    size: 12 12
    image-source: /images/ui/scrollbar_new_vertical
    image-clip: 10 24 12 12
    $pressed:
      image-clip: 10 36 12 12

  VerticalScrollBarQtSlider

TextListQuestLog < Panel
  font: verdana-11px-antialised
  width: 192
  text-offset: 24 5
  text-align: topLeft
  border-width: 1
  border-color: #00000077
  height: 425
  image-border: 4
  image-border-top: 23
  image-border-bottom: 4
  focusable: true

  TextList
    id: questList
    vertical-scrollbar: spellsScrollBar
    anchors.fill: parent
    padding: 1
    width: 10
    focusable: true
    background-color: #404040
    auto-focus: first

  VerticalQtScrollBar
    id: spellsScrollBar
    anchors.top: questList.top
    anchors.bottom: questList.bottom
    anchors.right: questList.right
    step: 50
    pixels-scroll: true
